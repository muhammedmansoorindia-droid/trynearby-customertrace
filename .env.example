# Customer Trace — local development environment
#
# PLACEHOLDERS ONLY. Copy to .env and fill in real values locally; .env is git-ignored.
# Never commit real passwords or signing keys.

# ── Database ────────────────────────────────────────────────────────────────
DB_USERNAME=ct
DB_PASSWORD=replace-with-a-local-password
DB_URL=jdbc:mysql://localhost:3399/customertrace?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_POOL_SIZE=10

# ── Signing key ──────────────────────────────────────────────────────────────
# MUST be at least 32 bytes. The app refuses to start with a missing or placeholder value.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
JWT_ISSUER=customer-trace-api

# ── Cookies ──────────────────────────────────────────────────────────────────
# Set REFRESH_COOKIE_SECURE=true when serving over HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# ── CORS ─────────────────────────────────────────────────────────────────────
# Explicit origin allow-list. Comma-separated; never "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Brute-force protection ───────────────────────────────────────────────────
AUTH_MAX_FAILED=5
AUTH_LOCKOUT=PT15M

# ── Development account seeding ──────────────────────────────────────────────
# Seeding only runs when BOTH are set, so no account can be created by accident.
# Create these accounts by choosing your own local password; it is BCrypt-hashed
# at startup and never stored in clear text.
BOOTSTRAP_ENABLED=false
DEV_ACCOUNT_PASSWORD=replace-with-a-local-development-password

# ── Misc ─────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
LOG_LEVEL=INFO

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Used by src/services/api.ts; no API URL is hardcoded in the frontend.
VITE_API_BASE_URL=http://localhost:8080